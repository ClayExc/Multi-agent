# Local development only. Copy to .env and replace every value outside local CI.
POSTGRES_DB=flowpilot
POSTGRES_USER=flowpilot_migrator
POSTGRES_PASSWORD=local-dev-postgres-change-me
POSTGRES_PORT=15432

REDIS_PASSWORD=local-dev-redis-change-me
REDIS_PORT=16379

KEYCLOAK_ADMIN=flowpilot-local-admin
KEYCLOAK_ADMIN_PASSWORD=local-dev-keycloak-change-me
KEYCLOAK_PORT=18081
FLOWPILOT_WEB_ORIGIN=http://127.0.0.1:18765
FLOWPILOT_OIDC_REDIRECT_URI=http://127.0.0.1:18765/oidc/callback
KEYCLOAK_WEB_CLIENT_SECRET=local-dev-web-client-change-me
KEYCLOAK_WORKER_CLIENT_SECRET=local-dev-worker-client-change-me
KEYCLOAK_GATEWAY_CLIENT_SECRET=local-dev-gateway-client-change-me
KEYCLOAK_TENANT_A_USER_PASSWORD=local-dev-tenant-a-user-change-me
KEYCLOAK_TENANT_A_APPROVER_PASSWORD=local-dev-tenant-a-approver-change-me
KEYCLOAK_TENANT_B_USER_PASSWORD=local-dev-tenant-b-user-change-me
KEYCLOAK_TENANT_B_APPROVER_PASSWORD=local-dev-tenant-b-approver-change-me

OPA_PORT=18181
OTEL_GRPC_PORT=14317
OTEL_HTTP_PORT=14318
