{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowpilot.local/schemas/evaluation-registry.v1.schema.json",
  "title": "FlowPilot EvaluationRegistry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "version",
    "status",
    "categories",
    "suite_policies",
    "deterministic_assertions",
    "judge_rubrics",
    "aggregation_rules"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "registry_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "status": {
      "enum": [
        "candidate",
        "frozen",
        "retired"
      ]
    },
    "categories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "functional",
        "safety_fault",
        "multimodal_optional",
        "routing_lora"
      ],
      "properties": {
        "functional": {
          "$ref": "#/$defs/categoryIds"
        },
        "safety_fault": {
          "$ref": "#/$defs/categoryIds"
        },
        "multimodal_optional": {
          "$ref": "#/$defs/categoryIds"
        },
        "routing_lora": {
          "$ref": "#/$defs/categoryIds"
        }
      }
    },
    "suite_policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "functional",
        "safety_fault",
        "multimodal_optional",
        "routing_lora"
      ],
      "properties": {
        "functional": {
          "$ref": "#/$defs/suitePolicy"
        },
        "safety_fault": {
          "$ref": "#/$defs/suitePolicy"
        },
        "multimodal_optional": {
          "$ref": "#/$defs/suitePolicy"
        },
        "routing_lora": {
          "$ref": "#/$defs/suitePolicy"
        }
      }
    },
    "deterministic_assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assertion_id",
          "gate_domain",
          "implementation_key",
          "parameters_schema",
          "allowed_suites"
        ],
        "properties": {
          "assertion_id": {
            "type": "string",
            "pattern": "^assert\\.[a-z0-9]+(?:[._-][a-z0-9]+)*\\.v[1-9][0-9]*$"
          },
          "gate_domain": {
            "enum": [
              "flow",
              "tool",
              "approval",
              "tenant",
              "security",
              "context",
              "observability",
              "evaluation"
            ]
          },
          "implementation_key": {
            "description": "Registry key resolved by trusted code; never a module or filesystem path.",
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "parameters_schema": {
            "type": "object"
          },
          "allowed_suites": {
            "$ref": "#/$defs/suites"
          }
        }
      }
    },
    "judge_rubrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rubric_id",
          "dimension",
          "gate_domain",
          "prompt_ref",
          "prompt_hash",
          "output_schema_ref",
          "calibration_policy_ref",
          "allowed_suites"
        ],
        "properties": {
          "rubric_id": {
            "type": "string",
            "pattern": "^judge\\.semantic\\.[a-z0-9]+(?:[._-][a-z0-9]+)*\\.v[1-9][0-9]*$"
          },
          "dimension": {
            "enum": [
              "answer_relevance",
              "summary_faithfulness",
              "citation_support",
              "clarification_quality",
              "ticket_description_quality"
            ]
          },
          "gate_domain": {
            "const": "semantic_only"
          },
          "prompt_ref": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          },
          "prompt_hash": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "output_schema_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "calibration_policy_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "allowed_suites": {
            "$ref": "#/$defs/suites"
          }
        }
      }
    },
    "aggregation_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministic_failure_precedence",
        "uncalibrated_judge_effect",
        "safety_score_source"
      ],
      "properties": {
        "deterministic_failure_precedence": {
          "const": true
        },
        "uncalibrated_judge_effect": {
          "const": "no_effect"
        },
        "safety_score_source": {
          "const": "deterministic_only"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "frozen"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "judge_rubrics": {
            "items": {
              "properties": {
                "prompt_ref": {
                  "type": "string",
                  "pattern": "^repo://",
                  "minLength": 1
                },
                "prompt_hash": {
                  "type": "string"
                },
                "output_schema_ref": {
                  "type": "string",
                  "pattern": "^repo://"
                },
                "calibration_policy_ref": {
                  "type": "string",
                  "pattern": "^repo://"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "categoryIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
      }
    },
    "suites": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "functional",
          "safety_fault",
          "multimodal_optional",
          "routing_lora"
        ]
      }
    },
    "suitePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_case_count",
        "category_counts",
        "denominator_policy",
        "required_assertions_by_category"
      ],
      "properties": {
        "expected_case_count": {
          "type": "integer",
          "minimum": 0
        },
        "category_counts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "propertyNames": {
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          }
        },
        "denominator_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "denominator",
            "passed",
            "failed",
            "skipped",
            "quarantined"
          ],
          "properties": {
            "denominator": {
              "const": "all_declared_cases"
            },
            "passed": {
              "const": "success"
            },
            "failed": {
              "const": "failure"
            },
            "skipped": {
              "const": "failure"
            },
            "quarantined": {
              "const": "failure"
            }
          }
        },
        "required_assertions_by_category": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^assert\\.[a-z0-9]+(?:[._-][a-z0-9]+)*\\.v[1-9][0-9]*$"
            }
          },
          "propertyNames": {
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          }
        }
      }
    }
  }
}
