{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowpilot.local/schemas/security-event.v1.schema.json",
  "title": "FlowPilot SecurityEvent v1",
  "description": "Unsampled, append-only security signal. Evidence is sanitized and reference-only; raw prompts, tool outputs, credentials, secrets, and PII are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "tenant_id",
    "trace_id",
    "thread_id",
    "task_id",
    "run_id",
    "producer",
    "producer_principal_ref",
    "correlation_id",
    "causation_id",
    "subject_context_ref",
    "subject_context_hash",
    "agent_principal",
    "control",
    "reason_codes",
    "severity",
    "category",
    "control_outcome",
    "impact",
    "disposition",
    "resource_refs",
    "evidence_refs",
    "policy_decision_id",
    "audit_event_id",
    "data_classification",
    "integrity"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^sevt_[A-Za-z0-9_-]{8,128}$"
    },
    "event_type": {
      "enum": [
        "security.authorization.denied.v1",
        "security.tenant_isolation.blocked.v1",
        "security.prompt_injection.detected.v1",
        "security.secret.detected.v1",
        "security.policy.unavailable.v1",
        "security.tool_schema.mismatch.v1",
        "security.egress.blocked.v1",
        "security.audit_integrity.violation.v1",
        "security.approval.invalid.v1",
        "security.idempotency.conflict.v1",
        "security.event_producer.unauthorized.v1"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "trace_id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "thread_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^thread_[A-Za-z0-9_-]{8,128}$"
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^task_[A-Za-z0-9_-]{8,128}$"
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^run_[A-Za-z0-9_-]{8,128}$"
    },
    "producer": {
      "enum": [
        "api",
        "worker",
        "mcp_gateway",
        "approval_service",
        "policy",
        "security_pipeline",
        "reconciler",
        "audit_verifier"
      ]
    },
    "producer_principal_ref": {
      "description": "Authenticated workload identity that stamped the producer field.",
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "subject_context_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "subject_context_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "agent_principal": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "principal_ref"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "principal_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      ]
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "rule_id",
        "rule_version"
      ],
      "properties": {
        "component": {
          "enum": [
            "api",
            "runtime",
            "context",
            "mcp_gateway",
            "policy",
            "persistence",
            "attachment_pipeline",
            "audit"
          ]
        },
        "rule_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "rule_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "category": {
      "enum": [
        "authorization",
        "tenant_isolation",
        "prompt_injection",
        "credential_exposure",
        "tool_integrity",
        "approval_integrity",
        "idempotency",
        "network_egress",
        "audit_integrity",
        "data_protection"
      ]
    },
    "control_outcome": {
      "enum": [
        "blocked",
        "allowed",
        "not_applicable",
        "unknown"
      ]
    },
    "impact": {
      "enum": [
        "none",
        "attempted",
        "suspected",
        "confirmed",
        "unknown"
      ]
    },
    "disposition": {
      "enum": [
        "open",
        "contained",
        "escalated",
        "resolved",
        "false_positive"
      ]
    },
    "resource_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "evidence_refs": {
      "description": "Sanitized object references or content hashes only.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "policy_decision_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^pd_[A-Za-z0-9_-]{8,128}$"
    },
    "audit_event_id": {
      "type": "string",
      "pattern": "^evt_[A-Za-z0-9_-]{8,128}$"
    },
    "data_classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "event_hash"
      ],
      "properties": {
        "canonicalization": {
          "const": "rfc8785"
        },
        "event_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "signature_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "task_id": {
            "type": "string"
          }
        },
        "required": [
          "task_id"
        ]
      },
      "then": {
        "properties": {
          "thread_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subject_context_ref": {
            "type": "string"
          }
        },
        "required": [
          "subject_context_ref"
        ]
      },
      "then": {
        "properties": {
          "subject_context_hash": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "subject_context_hash": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "security.authorization.denied.v1"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "subject_context_ref": {
            "type": "string",
            "minLength": 1
          },
          "subject_context_hash": {
            "type": "string"
          },
          "agent_principal": {
            "type": "object"
          },
          "policy_decision_id": {
            "type": "string"
          },
          "category": {
            "const": "authorization"
          },
          "control_outcome": {
            "const": "blocked"
          }
        }
      }
    }
  ]
}
