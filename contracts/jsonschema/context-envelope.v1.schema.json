{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowpilot.local/schemas/context-envelope.v1.schema.json",
  "title": "FlowPilot ContextEnvelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context_id",
    "task_id",
    "tenant_id",
    "agent_id",
    "purpose",
    "policy",
    "layers",
    "manifest"
  ],
  "properties": {
    "context_id": {
      "type": "string",
      "pattern": "^ctx_[A-Za-z0-9_-]{8,128}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^task_[A-Za-z0-9_-]{8,128}$"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_policy_version",
        "data_classification_ceiling",
        "provider_allowlist",
        "token_budget"
      ],
      "properties": {
        "context_policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "data_classification_ceiling": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "provider_allowlist": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "token_budget": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "trust",
          "classification",
          "content",
          "source_refs"
        ],
        "properties": {
          "name": {
            "enum": [
              "L0_SYSTEM_POLICY",
              "L1_SECURITY_VIEW",
              "L2_TASK_STATE",
              "L3_CONVERSATION_SUMMARY",
              "L4_RECENT_MESSAGES",
              "L5_RETRIEVAL_EVIDENCE",
              "L6_TOOL_OBSERVATIONS",
              "L7_EXAMPLES"
            ]
          },
          "trust": {
            "enum": [
              "controlled_instruction",
              "authenticated_derived",
              "business_state",
              "derived_data",
              "untrusted_data"
            ]
          },
          "classification": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted"
            ]
          },
          "content": {
            "$ref": "#/$defs/contextContent"
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "name": {
                  "const": "L0_SYSTEM_POLICY"
                }
              }
            },
            "then": {
              "properties": {
                "trust": {
                  "const": "controlled_instruction"
                },
                "content": {
                  "type": "object",
                  "minProperties": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "const": "L1_SECURITY_VIEW"
                }
              }
            },
            "then": {
              "properties": {
                "trust": {
                  "const": "authenticated_derived"
                },
                "content": {
                  "type": "object",
                  "minProperties": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "const": "L2_TASK_STATE"
                }
              }
            },
            "then": {
              "properties": {
                "trust": {
                  "const": "business_state"
                },
                "content": {
                  "type": "object",
                  "minProperties": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "const": "L3_CONVERSATION_SUMMARY"
                }
              }
            },
            "then": {
              "properties": {
                "trust": {
                  "const": "derived_data"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "const": "L4_RECENT_MESSAGES"
                }
              }
            },
            "then": {
              "properties": {
                "trust": {
                  "const": "untrusted_data"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "const": "L5_RETRIEVAL_EVIDENCE"
                }
              }
            },
            "then": {
              "properties": {
                "trust": {
                  "const": "untrusted_data"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "const": "L6_TOOL_OBSERVATIONS"
                }
              }
            },
            "then": {
              "properties": {
                "trust": {
                  "const": "untrusted_data"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "const": "L7_EXAMPLES"
                }
              }
            },
            "then": {
              "properties": {
                "trust": {
                  "const": "controlled_instruction"
                }
              }
            }
          }
        ]
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included_refs",
        "excluded_fields",
        "redactions",
        "input_tokens_estimated"
      ],
      "properties": {
        "included_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 512
          }
        },
        "excluded_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 512
          }
        },
        "redactions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 256
          }
        },
        "input_tokens_estimated": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens_actual": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "truncation_reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        }
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "layers": {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "L0_SYSTEM_POLICY"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "layers": {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "L1_SECURITY_VIEW"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "layers": {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "L2_TASK_STATE"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "layers": {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "L3_CONVERSATION_SUMMARY"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "layers": {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "L4_RECENT_MESSAGES"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "layers": {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "L5_RETRIEVAL_EVIDENCE"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "layers": {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "L6_TOOL_OBSERVATIONS"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "layers": {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "L7_EXAMPLES"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        }
      }
    }
  ],
  "$defs": {
    "contextContent": {
      "oneOf": [
        {
          "type": "object",
          "minProperties": 1
        },
        {
          "type": "array",
          "minItems": 1
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    }
  }
}
