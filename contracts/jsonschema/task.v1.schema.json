{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowpilot.local/schemas/task.v1.schema.json",
  "title": "FlowPilot Task Projection v1",
  "description": "Externally queryable projection of the LangGraph-owned business workflow. It is not directly mutable by API clients.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "thread_id",
    "tenant_id",
    "status",
    "version",
    "run_generation",
    "purpose",
    "data_classification",
    "security_context",
    "release",
    "waiting_on",
    "result_ref",
    "error",
    "created_at",
    "updated_at",
    "completed_at"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^task_[A-Za-z0-9_-]{8,128}$"
    },
    "thread_id": {
      "type": "string",
      "pattern": "^thread_[A-Za-z0-9_-]{8,128}$"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "$ref": "#/$defs/taskStatus"
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "run_generation": {
      "type": "integer",
      "minimum": 0
    },
    "active_run_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^run_[A-Za-z0-9_-]{8,128}$"
    },
    "latest_checkpoint_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "domain": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "intent": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "data_classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "security_context": {
      "$ref": "./security-context-ref.v1.schema.json"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph_version",
        "domain_pack_version",
        "context_policy_version",
        "policy_version",
        "tool_schema_set"
      ],
      "properties": {
        "graph_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "domain_pack_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "context_policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "tool_schema_set": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "waiting_on": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "request_id",
            "expires_at"
          ],
          "properties": {
            "type": {
              "enum": [
                "user_input",
                "approval"
              ]
            },
            "request_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "expires_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          }
        }
      ]
    },
    "result_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "retryable": {
              "type": "boolean"
            },
            "detail_ref": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 512
            }
          }
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "description": "Terminal timestamp for COMPLETED, CANCELLED, ESCALATED, or FAILED; null for non-terminal states.",
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "WAITING_USER"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "waiting_on": {
            "type": "object",
            "properties": {
              "type": {
                "const": "user_input"
              }
            },
            "required": [
              "type"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "WAITING_APPROVAL"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "waiting_on": {
            "type": "object",
            "properties": {
              "type": {
                "const": "approval"
              }
            },
            "required": [
              "type"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "not": {
              "enum": [
                "WAITING_USER",
                "WAITING_APPROVAL"
              ]
            }
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "waiting_on": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "COMPLETED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "result_ref": {
            "type": "string",
            "minLength": 1
          },
          "error": {
            "type": "null"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "not": {
              "const": "COMPLETED"
            }
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "result_ref": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "FAILED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "not": {
              "enum": [
                "FAILED",
                "ESCALATED"
              ]
            }
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "COMPLETED",
              "CANCELLED",
              "ESCALATED",
              "FAILED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "completed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "else": {
        "properties": {
          "completed_at": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "taskStatus": {
      "enum": [
        "RECEIVED",
        "RUNNABLE",
        "RUNNING",
        "WAITING_USER",
        "WAITING_APPROVAL",
        "VERIFYING",
        "COMPLETED",
        "CANCELLED",
        "ESCALATED",
        "FAILED"
      ]
    },
    "terminalStatus": {
      "enum": [
        "COMPLETED",
        "CANCELLED",
        "ESCALATED",
        "FAILED"
      ]
    }
  }
}
