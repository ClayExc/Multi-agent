{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowpilot.local/schemas/security-context-ref.v1.schema.json",
  "title": "FlowPilot SecurityContextRef v1",
  "description": "Opaque, integrity-bound reference to server-side identity and authorization attributes. It never contains bearer credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context_id",
    "context_ref",
    "context_hash",
    "tenant_id",
    "subject_id",
    "subject_type",
    "purpose",
    "authentication",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "context_id": {
      "type": "string",
      "pattern": "^secctx_[A-Za-z0-9_-]{8,128}$"
    },
    "context_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "context_hash": {
      "$ref": "#/$defs/sha256"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "subject_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "subject_type": {
      "enum": [
        "user",
        "service",
        "administrator"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "assurance_level"
      ],
      "properties": {
        "method": {
          "enum": [
            "oidc",
            "workload_identity",
            "break_glass"
          ]
        },
        "assurance_level": {
          "enum": [
            "low",
            "substantial",
            "high"
          ]
        },
        "session_id_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "delegation_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "data_classification_ceiling": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}

