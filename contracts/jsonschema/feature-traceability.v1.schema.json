{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowpilot.local/schemas/feature-traceability.v1.schema.json",
  "title": "FlowPilot FeatureTraceability Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_id",
    "version",
    "status",
    "source_of_truth",
    "features"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "status": {
      "enum": [
        "candidate",
        "frozen"
      ]
    },
    "source_of_truth": {
      "const": true
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature_id",
          "priority",
          "implementation_owner",
          "verification_owner",
          "observable_behavior",
          "target_paths",
          "tests",
          "evidence",
          "status",
          "valid_evidence_refs"
        ],
        "properties": {
          "feature_id": {
            "type": "string",
            "pattern": "^FP-[A-Z]+-[0-9]{3}$"
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "implementation_owner": {
            "$ref": "#/$defs/sessionRole"
          },
          "verification_owner": {
            "$ref": "#/$defs/sessionRole"
          },
          "observable_behavior": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "target_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "tests": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "test_id",
                "kind",
                "path"
              ],
              "properties": {
                "test_id": {
                  "type": "string",
                  "pattern": "^test\\.fp-[a-z]+-[0-9]{3}\\.[a-z0-9._-]+\\.v[1-9][0-9]*$"
                },
                "kind": {
                  "enum": [
                    "unit",
                    "contract",
                    "integration",
                    "e2e",
                    "recovery",
                    "security",
                    "evaluation",
                    "observability",
                    "chaos"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              }
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence_id",
                "type",
                "path_pattern",
                "description"
              ],
              "properties": {
                "evidence_id": {
                  "type": "string",
                  "pattern": "^evidence\\.fp-[a-z]+-[0-9]{3}\\.[a-z0-9._-]+\\.v[1-9][0-9]*$"
                },
                "type": {
                  "enum": [
                    "test_result",
                    "contract_report",
                    "trace_assertion",
                    "security_report",
                    "evaluation_report",
                    "operational_report",
                    "manifest"
                  ]
                },
                "path_pattern": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              }
            }
          },
          "status": {
            "enum": [
              "DESIGNED",
              "IMPLEMENTED",
              "VERIFIED",
              "RELEASED"
            ]
          },
          "valid_evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/validEvidenceRef"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "VERIFIED",
                    "RELEASED"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "valid_evidence_refs": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "sessionRole": {
      "enum": [
        "S1-ARCH",
        "S2-RUNTIME",
        "S3-PLATFORM",
        "S4-QUALITY",
        "S5-CORE",
        "S6-DATA"
      ]
    },
    "validEvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "test_id",
        "artifact_path",
        "artifact_hash",
        "run_id",
        "produced_at",
        "verifier_role"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^evidence\\.fp-[a-z]+-[0-9]{3}\\.[a-z0-9._-]+\\.v[1-9][0-9]*$"
        },
        "test_id": {
          "type": "string",
          "pattern": "^test\\.fp-[a-z]+-[0-9]{3}\\.[a-z0-9._-]+\\.v[1-9][0-9]*$"
        },
        "artifact_path": {
          "type": "string",
          "pattern": "^(?:artifacts|reports|evals)/[A-Za-z0-9._/-]+$",
          "maxLength": 512
        },
        "artifact_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$"
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        },
        "verifier_role": {
          "$ref": "#/$defs/sessionRole"
        }
      }
    }
  }
}
