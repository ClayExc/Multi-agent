{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowpilot.local/schemas/agent-run-result.v1.schema.json",
  "title": "FlowPilot AgentRunResult v1",
  "description": "Provider-neutral bounded Agent Runtime result. Public reasoning summaries are allowed; hidden chain-of-thought is forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_id",
    "request_id",
    "status",
    "trace_id",
    "provider",
    "structured_output",
    "public_reasoning_summary",
    "tool_proposals",
    "tool_call_refs",
    "handoff_proposal",
    "session_ref",
    "provider_run_ref",
    "usage",
    "error",
    "completed_at"
  ],
  "properties": {
    "result_id": {
      "type": "string",
      "pattern": "^arr_[A-Za-z0-9_-]{8,128}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^arq_[A-Za-z0-9_-]{8,128}$"
    },
    "status": {
      "enum": [
        "completed",
        "failed_retryable",
        "failed_final",
        "budget_exhausted",
        "guardrail_blocked"
      ]
    },
    "trace_id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "model"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "structured_output": {
      "type": [
        "object",
        "null"
      ]
    },
    "public_reasoning_summary": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    },
    "tool_proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "proposal_id",
          "tool",
          "operation",
          "arguments",
          "resource",
          "purpose",
          "evidence_refs"
        ],
        "properties": {
          "proposal_id": {
            "type": "string",
            "pattern": "^tprop_[A-Za-z0-9_-]{8,128}$"
          },
          "tool": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*\\.v[1-9][0-9]*$"
          },
          "operation": {
            "enum": [
              "read",
              "propose_write"
            ]
          },
          "arguments": {
            "type": "object"
          },
          "resource": {
            "type": "object"
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      }
    },
    "tool_call_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "handoff_proposal": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target_agent_id",
            "reason_code",
            "context_id"
          ],
          "properties": {
            "target_agent_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "reason_code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "context_id": {
              "type": "string",
              "pattern": "^ctx_[A-Za-z0-9_-]{8,128}$"
            }
          }
        }
      ]
    },
    "session_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "provider_run_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "tool_calls",
        "turns",
        "cost_microunits",
        "elapsed_ms"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "turns": {
          "type": "integer",
          "minimum": 0
        },
        "cost_microunits": {
          "type": "integer",
          "minimum": 0
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "retryable",
            "detail_ref"
          ],
          "properties": {
            "code": {
              "enum": [
                "RUNTIME_PROVIDER_UNAVAILABLE",
                "RUNTIME_REQUEST_INCONSISTENT",
                "RUNTIME_INVALID_OUTPUT",
                "RUNTIME_BUDGET_EXHAUSTED",
                "RUNTIME_GUARDRAIL_BLOCKED",
                "RUNTIME_TOOL_SCOPE_VIOLATION",
                "RUNTIME_DATA_POLICY_DENIED",
                "RUNTIME_INTERNAL"
              ]
            },
            "retryable": {
              "type": "boolean"
            },
            "detail_ref": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 512
            }
          }
        }
      ]
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "structured_output": {
            "type": "object"
          },
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "structured_output": {
            "type": "null"
          },
          "error": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed_retryable"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "properties": {
              "retryable": {
                "const": true
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "error": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "retryable": {
                    "const": false
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed_retryable"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "const": "RUNTIME_PROVIDER_UNAVAILABLE"
              },
              "retryable": {
                "const": true
              }
            },
            "required": [
              "code",
              "retryable"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed_final"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "enum": [
                  "RUNTIME_INVALID_OUTPUT",
                  "RUNTIME_REQUEST_INCONSISTENT",
                  "RUNTIME_TOOL_SCOPE_VIOLATION",
                  "RUNTIME_DATA_POLICY_DENIED",
                  "RUNTIME_INTERNAL"
                ]
              },
              "retryable": {
                "const": false
              }
            },
            "required": [
              "code",
              "retryable"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "budget_exhausted"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "const": "RUNTIME_BUDGET_EXHAUSTED"
              },
              "retryable": {
                "const": false
              }
            },
            "required": [
              "code",
              "retryable"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "guardrail_blocked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "const": "RUNTIME_GUARDRAIL_BLOCKED"
              },
              "retryable": {
                "const": false
              }
            },
            "required": [
              "code",
              "retryable"
            ]
          }
        }
      }
    }
  ]
}
